PORT=3001
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/glaszetter_snel

# JWT
JWT_SECRET=your-secret-key-change-in-production

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8081

# API
API_VERSION=v1

# Claude API (used to parse spoken measurement transcripts into structured fields)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Photo storage - S3-compatible object storage (AWS S3 or Cloudflare R2)
# For AWS S3: leave S3_ENDPOINT empty, set S3_REGION to your bucket's region
# For Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com, S3_REGION=auto
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
# Base URL used to build public photo URLs, e.g. https://your-bucket.s3.amazonaws.com
# or your R2 public bucket URL / CDN domain in front of the bucket
S3_PUBLIC_URL_BASE=https://your-bucket-public-url
